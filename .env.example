# Telegram API credentials
# Get these from https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# TDLib
# Apple Silicon Homebrew HEAD:
# /opt/homebrew/opt/tdlib/lib/libtdjson.dylib
# Intel Homebrew HEAD:
# /usr/local/opt/tdlib/lib/libtdjson.dylib
TDLIB_LIBRARY_PATH=vendor/td/build/libtdjson.dylib
TDLIB_DATABASE_DIR=tdlib_data/database
TDLIB_FILES_DIR=tdlib_data/files
TDLIB_DATABASE_ENCRYPTION_KEY=change-me

# Optional fallback IDs when no chat has been selected
TARGET_USER_ID=
TARGET_TDLIB_CHAT_ID=

# Generation provider: auto, ollama, or mlx
CHAT_GENERATION_PROVIDER=auto
GENERATION_FALLBACK_PROVIDER=ollama
GENERATION_FALLBACK_ON_ERROR=true

# Ollama generation and ranking
OLLAMA_HOST=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen3:8b
DEFAULT_OLLAMA_CHAT_MODEL=qwen3:8b
OLLAMA_EMBED_MODEL=qwen3-embedding:0.6b
OLLAMA_KEEP_ALIVE=30m

# MLX generation
# Leave MLX_CHAT_MODEL empty to use adapter metadata or TRAIN_BASE_MODEL
MLX_CHAT_MODEL=
MLX_MAX_TOKENS=700
MLX_TEMPERATURE=0.55

# Sync
HISTORY_SYNC_LIMIT=3000
STARTUP_SYNC_ON_RUN=true
STARTUP_SYNC_LIMIT=1000
RESULT_JSON_MAX_MESSAGES=3000

# Batching
INCOMING_BATCH_DELAY_SECONDS=5
OUTGOING_BATCH_DELAY_SECONDS=5

# Prediction
CANDIDATE_COUNT=3
RECENT_CONTEXT_MAX_MESSAGES=100
MAX_MESSAGES_PER_CANDIDATE=4
REPLY_USE_PROBABILITY=0.4

# Matching and ranking
MATCH_INFERRED_THRESHOLD=0.88
MATCH_INDEPENDENT_THRESHOLD=0.55
RANK_STYLE_WEIGHT=0.35
RANK_RELEVANCE_WEIGHT=0.35
RANK_LENGTH_WEIGHT=0.10
RANK_NATURALNESS_WEIGHT=0.20

# App mode
APP_MODE=manual
AUTO_SEND_DELAY_SECONDS=2
AUTO_MIN_FINAL_SCORE=0.0

# Training dataset
TRAIN_CONTEXT_BLOCKS=8
TRAIN_MIN_TARGET_CHARS=1
TRAIN_MAX_TARGET_CHARS=800
TRAIN_VALID_RATIO=0.10

# MLX training
TRAIN_BASE_MODEL=mlx-community/Llama-3.2-3B-Instruct-4bit
TRAIN_ITERS=100
CONTINUE_TRAIN_ITERS=20
TRAIN_BATCH_SIZE=1
TRAIN_NUM_LAYERS=4

# MLX adapter testing
TEST_MAX_TOKENS=120
TEST_TEMPERATURE=0.55

# Reserved feedback-ranking settings (currently unused)
RANK_FEEDBACK_WEIGHT=0.20
FEEDBACK_EXAMPLE_LIMIT=80
FEEDBACK_MIN_POSITIVE_EXAMPLES=3
FEEDBACK_TOP_K=8
