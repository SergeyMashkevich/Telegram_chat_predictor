# Telegram API credentials
# Get these from https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# TDLib
TDLIB_LIBRARY_PATH=vendor/td/build/libtdjson.dylib
TDLIB_DATABASE_DIR=tdlib_data/database
TDLIB_FILES_DIR=tdlib_data/files
TDLIB_DATABASE_ENCRYPTION_KEY=change-me

# Ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen3:8b
DEFAULT_OLLAMA_CHAT_MODEL=qwen3:8b
OLLAMA_EMBED_MODEL=qwen3-embedding:0.6b

# Sync
HISTORY_SYNC_LIMIT=3000
STARTUP_SYNC_ON_RUN=true
STARTUP_SYNC_LIMIT=1000

# Batching
INCOMING_BATCH_DELAY_SECONDS=5
OUTGOING_BATCH_DELAY_SECONDS=5

# Prediction
CANDIDATE_COUNT=3
RECENT_CONTEXT_MAX_MESSAGES=100
OLLAMA_KEEP_ALIVE=30m
MAX_MESSAGES_PER_CANDIDATE=4
REPLY_USE_PROBABILITY=0.4

# Matching
MATCH_INFERRED_THRESHOLD=0.88
MATCH_INDEPENDENT_THRESHOLD=0.55

# App mode
APP_MODE=manual
AUTO_SEND_DELAY_SECONDS=2
AUTO_MIN_FINAL_SCORE=0.0

# Training dataset
TRAIN_CONTEXT_BLOCKS=8
TRAIN_MIN_TARGET_CHARS=1
TRAIN_MAX_TARGET_CHARS=800
TRAIN_VALID_RATIO=0.10

# MLX training
TRAIN_BASE_MODEL=mlx-community/Llama-3.2-3B-Instruct-4bit
TRAIN_ITERS=100
CONTINUE_TRAIN_ITERS=20
TRAIN_BATCH_SIZE=1
TRAIN_NUM_LAYERS=4

# Feedback ranking
RANK_FEEDBACK_WEIGHT=0.20
FEEDBACK_EXAMPLE_LIMIT=80
FEEDBACK_MIN_POSITIVE_EXAMPLES=3
FEEDBACK_TOP_K=8
